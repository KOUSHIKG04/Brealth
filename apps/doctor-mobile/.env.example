EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
EXPO_PUBLIC_ENABLE_DEV_PASSWORD_LOGIN=false
# Android clinic map: set in .env.local and the matching EAS build environment.
# Restrict the key to the Doctor Android package + signing SHA-1 and Maps SDK for Android.
GOOGLE_MAPS_ANDROID_API_KEY=

# Optional error monitoring (PostHog). Leave empty to disable: nothing is sent.
# Only scrubbed exception events are captured; no users, screens or replays.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
