NEXT_PUBLIC_SUPABASE_URL=https://YOUR_DISPOSABLE_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Optional error monitoring (PostHog). Leave empty to disable: nothing is sent.
# Only scrubbed exception events are captured; no users, page views or replays.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
